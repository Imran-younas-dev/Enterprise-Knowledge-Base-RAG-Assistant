{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "eslint src --fix && babel-node index.js",
    "start": "node dist/main.js",
    "build": "babel src --out-dir dist --copy-files",
    "cron-dev": "eslint src --fix && babel-node cron.index.js",
    "queue-dev": "eslint src --fix && babel-node queue.index.js",
    "lintfix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "db:check": "babel-node src/scripts/check-database.js",
    "migrate": "sequelize-cli db:migrate",
    "seed": "sequelize-cli db:seed:all",
    "undo": "sequelize-cli db:migrate:undo"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "dotenv": "^16.6.1",
    "mysql2": "^3.15.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sequelize": "^6.37.7",
    "sequelize-typescript": "^2.1.6"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/eslint-parser": "^7.28.4",
    "@babel/node": "^7.28.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@babel/preset-env": "^7.28.3",
    "@babel/register": "^7.28.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "sequelize-cli": "^6.6.3"
  }
}
