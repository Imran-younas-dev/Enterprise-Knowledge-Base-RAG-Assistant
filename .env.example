# Embedding model. These values are not secrets.
# local + Xenova/all-MiniLM-L6-v2 produces 384 numbers per chunk.
# Changing the model or EMBEDDING_DIMENSIONS means embedding every chunk again.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

PORT=6000
CLIENT_SECRET=change-me

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=imran
DB_PASSWORD=Root@123
DB_NAME=rag

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
BULL_PREFIX=rag

UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=10485760
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
